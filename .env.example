# Google SMTP App Password (not an API key). Keep this file private.
GMAIL_USER=your-sender@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
# Create a long random key used ONLY by teachers to access /teacher.
LITERA_TEACHER_KEY=replace-with-a-long-random-private-key
PORT=8765
# Optional: Whisper model for provisional speech feedback (downloaded on first use)
LITERA_SPEECH_MODEL=base.en
